  "header": {"alg": "RS256", "typ": "JWT"},
  "request_envelope_fields": ["proof"],
  "response_envelope_fields": ["decision_jwt"],
  "maximum_token_bytes": 8192,
  "maximum_envelope_bytes": 16384,
  "maximum_integer_time": 9007199254740991,
  "request_ttl_seconds": 30,
  "reply_maximum_ttl_seconds": 15,
  "future_skew_seconds": 5,
  "request_timeout_seconds": 3,
  "reply_expiry_capped_to_request": true,
  "request_nonce_reused": false,
  "operations": {
    "canonical_admin": {
