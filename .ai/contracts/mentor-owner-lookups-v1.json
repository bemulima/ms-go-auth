    },
    "committed_intent": {
      "subject": "mentor.confirmCommittedRoleIntent.v1",
      "request_claims": ["iss", "aud", "sub", "typ", "purpose", "subject", "jti", "iat", "exp", "target_user_id", "application_id", "application_revision", "decision", "request_id", "decision_digest"],
      "constants": {
        "iss": "ms-go-auth",
        "aud": "ms-go-mentor-committed-role-intent",
        "typ": "mentor_committed_role_intent_check",
        "purpose": "AUTH_MENTOR_COMMITTED_ROLE_INTENT_V1"
      },
      "response_owner_contract": "ms-go-mentor/.ai/contracts/mentor-committed-intent-decision-v1.json"
    }
  }
}
